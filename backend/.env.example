# Synapse v2 backend configuration

SYNAPSE_HOST=127.0.0.1
SYNAPSE_PORT=8001

# --- Graph store (Neo4j Aura) ---

SYNAPSE_GRAPH_BACKEND=neo4j

SYNAPSE_NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
SYNAPSE_NEO4J_USER=your-neo4j-username
SYNAPSE_NEO4J_PASSWORD=your-neo4j-password
SYNAPSE_GRAPH_DATABASE=

# --- Extraction ---

SYNAPSE_LLM_PROVIDER=groq

SYNAPSE_NVIDIA_API_KEY=your-nvidia-api-key
SYNAPSE_NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro-0813

# --- Fallback LLM Config ---

SYNAPSE_GROQ_API_KEY=your-groq-api-key
SYNAPSE_GROQ_MODEL=openai/gpt-oss-120b

# --- HuggingFace Token for gated models (like Google EmbeddingGemma) ---

SYNAPSE_HF_TOKEN=your-huggingface-token
SYNAPSE_EMBEDDING_DIM=1024

# --- Extraction Mode ---

SYNAPSE_DYNAMIC_EXTRACTION=true

# --- GitHub App ---

# Change to your actual GitHub App ID
SYNAPSE_GITHUB_APP_ID=your-github-app-id

# Keep the \n formatting for the private key
SYNAPSE_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"

SYNAPSE_GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# --- Bootstrap Credentials ---

SYNAPSE_BOOTSTRAP_ADMIN_EMAIL=admin@synapse.local
SYNAPSE_BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- Google Mail OAuth ---

SYNAPSE_MAIL_GOOGLE_CLIENT_ID=your-google-client-id
SYNAPSE_MAIL_GOOGLE_CLIENT_SECRET=your-google-client-secret
SYNAPSE_MAIL_GOOGLE_REDIRECT_URI=http://localhost:5173/mail/oauth/callback

# --- Polling ---

SYNAPSE_MAIL_DEFAULT_POLL_INTERVAL_MINUTES=15
SYNAPSE_GITHUB_DEFAULT_POLL_INTERVAL_HOURS=0